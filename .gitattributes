# 默认：自动识别文本并统一以 LF 存入版本库
* text=auto

# Gradle Wrapper / Shell 脚本：检出亦为 LF
gradlew text eol=lf
gradlew.bat text eol=crlf
*.sh text eol=lf
*.bat text eol=crlf

# 二进制资源：不做换行符转换与文本差异处理
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.jar binary
*.apk binary
*.aab binary
*.jks binary
*.keystore binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
